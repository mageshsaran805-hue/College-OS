# College OS — environment template
#
# Copy to `.env` and fill in the values:
#   cp .env.example .env
# `.env` is git-ignored; this file is not.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application connects through the Supabase transaction pooler.
# `pgbouncer=true&connection_limit=1` is required: Prisma opens one connection
# per request, and without these the pooler exhausts under concurrency.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432). Used by `prisma migrate`, which needs DDL and
# cannot run through a transaction pooler.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL. Used for absolute links (sign-out redirect, password-reset
# links) and for the HSTS/secure-cookie decision in production.
APP_URL="http://localhost:3000"

# Auth.js signing secret. Generate one with:
#   openssl rand -base64 32
# Required in production. The development fallback is never used for a
# production build.
AUTH_SECRET=""

# Public canonical Auth.js URL. Keep this aligned with APP_URL in production.
AUTH_URL="http://localhost:3000"

# `lax` (default) or `none` (cross-site embedding; requires HTTPS and
# `Secure` cookies). `strict` is also accepted.
SESSION_SAME_SITE="lax"

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# `local` for development, `supabase` for production.
STORAGE_DRIVER="local"

# Optional: a subfolder of ./storage, or an absolute path for a mounted volume.
# STORAGE_LOCAL_ROOT=""

# Required when STORAGE_DRIVER="supabase". The bucket must be private; the app
# authorises every download before reading a single byte.
# SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# SUPABASE_STORAGE_BUCKET="college-os-files"

# ---------------------------------------------------------------------------
# Transactional email (optional)
# ---------------------------------------------------------------------------
# Without SMTP_HOST the password-reset link is written to the server log in
# development only; it is never logged in production.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="no-reply@college.edu"

# ---------------------------------------------------------------------------
# Diagnostics (optional)
# ---------------------------------------------------------------------------
# Set to "1" to log one JSON line per proxied request (method, path, cookie
# presence, forwarded headers). Useful when debugging a deployment behind a
# reverse proxy. Never enable in production for long.
# PROXY_DEBUG=""

# ---------------------------------------------------------------------------
# Development seeding
# ---------------------------------------------------------------------------
# Used only by `npm run db:seed`. If omitted outside production, the seed uses
# the documented development password. Production seeding requires this value.
# SEED_DEMO_PASSWORD=""
